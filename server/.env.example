# Resibo — environment file TEMPLATE. This file IS committed; it carries names
# only, never values. Copy it to the environment you are running:
#
#   .env.dev      local development  (loaded by default)
#   .env.prelive  staging            (APP_ENV=prelive)
#   .env.prod     production         (APP_ENV=prod)
#
# Which file is loaded is decided by APP_ENV — see `spring.config.import` in
# src/main/resources/application.yaml. Every .env.* file is git-ignored except
# this template. On the server the file lives outside the checkout, at
# /opt/resibo/resibo.env, and is named by RESIBO_ENV_FILE.
#
# Parsed as a .properties file, so: no `export`, no shell expansion, no quotes
# around values, and a literal `#` starts a comment.
#
# The datasource values have NO defaults in application.yaml. If they are
# missing the application fails to start — deliberately, so it can never
# silently connect somewhere unintended.

# --- Server ---------------------------------------------------------------
# Port the API listens on. application.yaml falls back to 8080 if unset.
# Inside the container this is forced to 8080 by docker-compose.yml; the
# published host port is set by HOST_PORT at deploy time.
SERVER_PORT=

# --- Database -------------------------------------------------------------
# MariaDB. Hibernate `ddl-auto` is `none`, so the application never creates or
# alters tables — the schema is owned outside the application.
#
# Use the least-privilege account, not the instance superuser — that same
# instance hosts unrelated project databases. A dedicated account exists:
#
#   GRANT ALL PRIVILEGES ON `resibo`.* TO 'resibo'@'%'
#
# It holds USAGE only at the global level and has no GRANT OPTION, so it can
# do anything inside its own schema and nothing outside it. The superuser is
# reserved for migrations and backups, run by a person.
DATASOURCE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Hikari pool size. Defaults to 10 if unset.
DB_POOL_MAX=

# --- CORS ----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
#
# Leave this blank and application.yaml supplies the real list, which is
# what production runs on:
#
#   https://resibo.polbinsenthabyer.uk,http://localhost:5173,http://127.0.0.1:5173
#
# The default is deliberately NOT "*" — an environment that forgets this
# variable should fail closed. localhost is in the list on purpose: the
# client defaults to calling the DEPLOYED API, so `npm run dev` is a
# cross-origin call from localhost even when no backend is running here.
#
# Set it only to narrow or extend that list, e.g. to add a prelive origin.
# Note: naming origins explicitly also turns credentials ON, because
# browsers forbid credentialed requests from a "*" origin. Resibo does not
# use cookies — the token goes in the Authorization header — so this
# changes nothing today.
CORS_ALLOWED_ORIGINS=

# --- JWT ------------------------------------------------------------------
# Signing key for login tokens. REQUIRED - there is no default, and the app
# refuses to start without it. Must be at least 32 characters or it fails at
# boot with a clear message.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Use a DIFFERENT key per environment, so a token minted locally is useless
# against the deployed server. Changing it invalidates every issued token.
JWT_SECRET=

# Token lifetime in milliseconds. Defaults to 28800000 (8 hours) if unset.
JWT_EXPIRATION=

{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Imports: "@/..." means "src/...". Kept in step with resolve.alias in
       vite.config.ts — change one and you must change the other.
       TypeScript 7 removed `baseUrl`, so the mapping is relative to this file
       and the leading "./" is required. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting. `strict` is set explicitly rather than relied on as a default,
       because it is the one flag whose absence quietly changes what the rest
       of these mean. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

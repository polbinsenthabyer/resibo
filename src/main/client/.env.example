# Resibo client — environment TEMPLATE. Committed; carries names only.
#
# Everything here is PUBLIC. Vite inlines every VITE_-prefixed value into the
# JavaScript bundle the browser downloads, so a credential must never appear in
# a file like this one. See resibo-plan.md §8.
#
# None of these are required. The defaults in src/config/env.ts cover both
# `npm run dev` (vite proxies /api to localhost:8083) and a production build
# served from the same origin as the API.

# Absolute base URL for the API, including the /api prefix. Set this only when
# the frontend is served from a different origin than the backend, e.g.
#   VITE_API_BASE_URL=https://resibo-api.polbinsenthabyer.uk/api
VITE_API_BASE_URL=

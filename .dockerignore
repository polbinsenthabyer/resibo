# Keep the build context small and — more importantly — keep secrets and local
# state out of the image entirely.

# Secrets: never copied into a build context, under any name.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# Build output — the image builds its own.
target/
build/

# The React client (src/main/client) is built by its own toolchain, never by
# the Java image. Excluded outright rather than only ignoring node_modules,
# because the Dockerfile copies the whole of src/ and nothing under this
# directory is an input to the Maven build.
src/main/client/

# Node, in case a frontend build context is ever added here.
node_modules/
dist/
.vite/

# Version control and CI
.git/
.github/
.gitignore
.gitattributes

# IDE / OS
.idea/
.vscode/
*.iml
Thumbs.db
Desktop.ini
.DS_Store

# Docs — not needed at runtime, and changing them should not bust the
# dependency cache layer.
*.md
docs/
